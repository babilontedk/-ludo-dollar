# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# API Configuration
API_BASE_URL=https://api.MYDOMAIN.com
API_PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ludo_dollar
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_MODE=test
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Ludo Dollar
SMTP_FROM_EMAIL=noreply@ludodollar.com

# Game Configuration
GAME_ENTRY_LEVELS=1000,4000,10000,25000,50000,100000
PLATFORM_FEE_PERCENTAGE=25
DEPOSIT_FEE_PERCENTAGE=3
WITHDRAWAL_FEE_PERCENTAGE=5

# Matchmaking Configuration
MATCHMAKING_TIMEOUT=30000
TURN_TIMEOUT=60000
DISCONNECT_TIMEOUT=120000

# Security
RATES_LIMIT_WINDOW=15
RATES_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:8080,https://MYDOMAIN.com

# Admin Settings
ADMIN_EMAIL=admin@ludodollar.com
ADMIN_PASSWORD=change_this_in_production

# Demo Mode
DEMO_MODE=true
PAYMENT_MODE=disabled
